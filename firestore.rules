rules_version = '2';

// Reglas de Proyecto Taxi.
// Integridad de datos:
//   - Asientos válidos (nunca negativos ni superiores al total).
//   - Reserva atómica: solo se crea si descuenta exactamente sus asientos del viaje (scheduled o in_route).
//   - Transición de estados permitida: scheduled -> in_route -> completed (o cancelled).
//   - Control de administración: usuarios con registro en /admins/{uid} pueden moderar, auditar y gestionar finanzas.

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: verifica si el usuario autenticado es un administrador registrado
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'gestorbusiness2013@gmail.com'
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        || (request.auth.token.email != null && exists(/databases/$(database)/documents/admins/$(request.auth.token.email)))
      );
    }

    // ---------------- Administradores ----------------
    match /admins/{adminId} {
      // Cualquier usuario autenticado puede comprobar administradores
      allow read: if request.auth != null;
      // Solo editable por un admin
      allow write: if isAdmin();
    }

    // ---------------- Usuarios ----------------
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isAdmin() || validUser(request.resource.data);
      allow delete: if isAdmin();
    }

    function validUser(u) {
      return u.name is string && u.name.size() > 0
        && u.phone is string
        && u.dni is string
        && u.role in ['driver', 'passenger'];
    }

    // ---------------- Viajes ----------------
    match /trips/{tripId} {
      allow read: if true;
      allow create: if isAdmin() || validNewTrip(request.resource.data);
      allow update: if isAdmin() || validNewTrip(request.resource.data) || seatsDecrease() || statusAdvance();
      allow delete: if isAdmin();
    }

    function validNewTrip(t) {
      return t.driverId is string
        && t.origin is string && t.destination is string
        && t.departureTime is string
        && t.totalSeats is int && t.totalSeats > 0 && t.totalSeats <= 8
        && t.availableSeats is int && t.availableSeats >= 0 && t.availableSeats <= t.totalSeats
        && t.pricePerSeat is number && t.pricePerSeat > 0
        && t.status in ['scheduled', 'in_route'];
    }

    // Reserva: solo cambia availableSeats, baja, nunca negativo, viaje programado o en ruta.
    function seatsDecrease() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['availableSeats'])
        && resource.data.status in ['scheduled', 'in_route']
        && request.resource.data.availableSeats is int
        && request.resource.data.availableSeats >= 0
        && request.resource.data.availableSeats < resource.data.availableSeats;
    }

    // Cambio de estado: solo cambia status y en el orden permitido.
    function statusAdvance() {
      let from = resource.data.status;
      let to = request.resource.data.status;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && ((from == 'scheduled' && to in ['in_route', 'cancelled'])
          || (from == 'in_route' && to == 'completed'));
    }

    // ---------------- Reservas ----------------
    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if isAdmin() || validNewBooking(bookingId, request.resource.data);
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && resource.data.status == 'confirmed'
        && request.resource.data.status in ['boarded', 'cancelled']
      );
      allow delete: if isAdmin();
    }

    function validNewBooking(bookingId, b) {
      let tripPath = /databases/$(database)/documents/trips/$(b.tripId);
      let before = get(tripPath).data;
      let after = getAfter(tripPath).data;
      return b.status == 'confirmed'
        && b.boardingPin is string && b.boardingPin.matches('^[0-9]{4}$')
        && bookingId == b.tripId + '_' + b.boardingPin
        && b.id == bookingId
        && b.seatsBooked is int && b.seatsBooked > 0
        && b.passengerId != before.driverId
        && before.status in ['scheduled', 'in_route']
        && after.availableSeats == before.availableSeats - b.seatsBooked;
    }

    // ---------------- Finanzas / Pagos de Suscripción ----------------
    match /payments/{paymentId} {
      allow read, write: if isAdmin();
    }

    // ---------------- Reportes y S.O.S. ----------------
    match /reports/{reportId} {
      // Cualquier pasajero o chofer puede emitir una alerta S.O.S. o queja
      allow create: if request.resource.data.type in ['sos', 'complaint', 'dispute']
        && request.resource.data.message is string;
      // Solo el administrador puede leer, gestionar y resolver reportes
      allow read, update, delete: if isAdmin();
    }

    // ---------------- Reseñas / Calificaciones ----------------
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update, delete: if isAdmin();
    }

    // ---------------- Configuraciones (Tasa BCV, etc.) ----------------
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
