# ==============================================================================
# PROYECTO TAXI - VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# Copia este archivo como .env.local para desarrollo local:
#   cp .env.example .env.local
#
# Para despliegue en Vercel:
#   Ve a: Project Settings -> Environment Variables y agrega cada variable.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configuración de Firebase / Cloud Firestore (Base de Datos en Tiempo Real)
# ------------------------------------------------------------------------------
# Obtenidas en la Consola de Firebase:
# Configuración del Proyecto -> Tus apps -> SDK setup and configuration -> Config
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="proyecto-taxi-ve.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="proyecto-taxi-ve"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="proyecto-taxi-ve.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# ------------------------------------------------------------------------------
# 2. Configuración de la Aplicación y Despliegue
# ------------------------------------------------------------------------------
# URL pública canónica en producción (Vercel) o local
NEXT_PUBLIC_APP_URL="https://proyecto-taxi.vercel.app"

# ------------------------------------------------------------------------------
# 3. Parámetros Iniciales del Mapa Interactivo (Opcional)
# ------------------------------------------------------------------------------
# Coordenadas iniciales (por defecto: Autopista Regional del Centro - ARC)
NEXT_PUBLIC_MAP_DEFAULT_CENTER_LAT="10.25"
NEXT_PUBLIC_MAP_DEFAULT_CENTER_LNG="-67.45"
NEXT_PUBLIC_MAP_DEFAULT_ZOOM="9"
